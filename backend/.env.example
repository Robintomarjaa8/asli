# ============================================
# ASLI E-Commerce Backend Environment Variables
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
# Get from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Replace <username> and <password> with your database user credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.5eo8odg.mongodb.net/asli-ecommerce

# JWT Authentication
# Use a strong secret (32+ characters) in production
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Cloudinary (for image uploads)
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (optional - for notifications)
# For Gmail, create an App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=ASLI E-Commerce <your_email@gmail.com>

# Frontend URL
# For local dev: http://localhost:5173
# For production: https://asli-three.vercel.app
FRONTEND_URL=https://asli-three.vercel.app
