# ============================================
# ASLI E-Commerce Frontend Environment Variables
# ============================================

# Backend API URL
# For local development, use http://localhost:5000/api
# For production (Vercel), use your deployed backend URL:
#   Example: https://asli-backend.onrender.com/api
#   IMPORTANT: Set this in Vercel dashboard → Project → Settings → Environment Variables
VITE_API_URL=http://localhost:5000/api