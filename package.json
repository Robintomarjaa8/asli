{
  "name": "asli-ecommerce",
  "version": "1.0.0",
  "description": "ASLI Shoppe - Multi-Vendor E-Commerce Platform",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "seed": "npm --prefix backend run seed",
    "seed:destroy": "npm --prefix backend run seed:destroy"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}